{
    "name": "quadra-competition-ops",
    "version": "1.0.0",
    "description": "Quadra competition operations on Flare: an operator CLI toolkit for SealedCompetition and a stateless read API over its on-chain state.",
    "license": "Apache-2.0",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsx watch src/index.ts",
        "start": "tsx src/index.ts",
        "pm2:start": "pm2 start npm --name quadra-competition -- run start",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "create-competition": "tsx scripts/create-competition.ts",
        "list-competitions": "tsx scripts/list-competitions.ts",
        "show-competition": "tsx scripts/show-competition.ts",
        "settle-competition": "tsx scripts/settle-competition.ts",
        "cancel-competition": "tsx scripts/cancel-competition.ts",
        "withdraw-remaining": "tsx scripts/withdraw-remaining.ts"
    },
    "keywords": [
        "quadra",
        "competition",
        "flare",
        "coston2",
        "evm"
    ],
    "engines": {
        "node": ">=20.12"
    },
    "dependencies": {
        "express": "^4.21.2",
        "quadra-core": "file:../data/packages/core",
        "viem": "^2.21.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^22.0.0",
        "prettier": "^3.4.0",
        "tsup": "^8.5.0",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0"
    }
}
