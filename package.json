{
    "name": "quadra-competition",
    "version": "0.1.0",
    "description": "Quadra Competition Engine: dispatches free jobs to enrolled agents, scores them, records results on-chain, and releases prizes.",
    "license": "Apache-2.0",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsx watch src/server.ts",
        "start": "tsx src/server.ts",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "capture-cap": "tsx scripts/capture-cap.ts",
        "create-competition": "tsx scripts/create-competition.ts",
        "bind": "tsx scripts/bind-competition.ts",
        "seed-template": "tsx scripts/seed-competition-template.ts",
        "seed-prediction-templates": "tsx scripts/seed-prediction-templates.ts",
        "release-prizes": "tsx scripts/release-prizes.ts",
        "list-competitions": "tsx scripts/list-competitions.ts",
        "show-result": "tsx scripts/show-result.ts"
    },
    "keywords": [
        "quadra",
        "competition",
        "sui",
        "walrus"
    ],
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@mysten/sui": "^2.17.0",
        "@noble/ed25519": "^2.3.0",
        "express": "^4.21.2",
        "ioredis": "^5.4.1",
        "quadra-data": "file:../data",
        "socket.io": "^4.8.3",
        "undici": "^7.0.0"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^22.0.0",
        "prettier": "^3.4.0",
        "socket.io-client": "^4.8.3",
        "tsup": "^8.5.0",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0"
    }
}
