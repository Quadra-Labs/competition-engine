# Quadra competition ops — configuration.
#
# Copy to .env, or set these in one shared .env beside the sibling checkouts
# (C:\stacks\projects\flare_quadra\.env), which configures every repo at once.
# Search order, nearest first: ./.env, <repo>/.env, <parent of the checkouts>/.env, ~/.quadra/.env.
#
# Values already exported in the environment always WIN over a file, so a secret injected by pm2 or
# a container cannot be silently downgraded by a stale .env on disk.
#
# The read service (npm start) needs only the chain section. The operator CLIs need a key, and
# settle-competition also needs the evaluation engine section.

# --- chain ---------------------------------------------------------------------------------------
CHAIN_ID=114
CHAIN_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Leave blank to read them from contracts/deployments/<CHAIN_ID>.json, so a redeploy needs no edit
# here. An explicit value always wins over the file.
SEALED_COMPETITION=
QUADRA_TOKEN=

# Where to look for that deployment file, if it is not in a sibling checkout. Read by quadra-core.
# CONTRACTS_DIR=../contracts

# Blocks per eth_getLogs window, read by quadra-core. Coston2's public RPC caps a single range at
# 30 blocks and rejects anything wider, so raise this only against a node with a larger cap.
LOG_CHUNK_BLOCKS=30

# The block SealedCompetition was deployed in — the floor for every log scan. There is no safe
# default, so this is required.
#
# Too LOW is merely slow: logs from an older deployment are filtered out by address anyway.
# Too HIGH silently HIDES competitions, which looks like an empty chain rather than an error.
# Never set it above the deploy block. It does not propagate on a redeploy: .env is gitignored, so
# check _migration/DEPLOYMENT-STATE.md after every one.
FROM_BLOCK=33930846

# --- identity (the operator CLIs only) -------------------------------------------------------------
# The wallet that creates competitions. It must be an operator on SealedCompetition — the contract
# owner grants that with setOperator(address, true) — and it needs C2FLR for gas plus QUADRA for any
# prize it funds.
#
# The read service never reads this and cannot sign anything. Leave it unset on a serving host.
#
# Prefer a DIFFERENT wallet from the scheduler relayer's: the write lock only serializes writes
# inside one process, so two processes signing with one key can take the same nonce.
#
# Never commit it, never paste it into a log or an issue.
COMPETITION_PRIVATE_KEY=0x

# --- evaluation engine (settle-competition only) ---------------------------------------------------
# 127.0.0.1 rather than localhost on purpose: localhost can resolve to ::1 and hang on a service
# listening only on v4.
EVAL_URL=http://127.0.0.1:3000

# Sent as x-intake-token. The engine guards /settle-competition only when it has one set, and BOTH
# sides must carry the same value — a token here with none there is not an error, it is unguarded.
INTAKE_INTERNAL_TOKEN=

# Building a settlement makes the enclave scan logs and fetch oracle proofs, so it is slower than a
# normal RPC call.
EVAL_TIMEOUT_MS=30000

# --- timing --------------------------------------------------------------------------------------
# Event watcher poll interval, and the receipt poll interval for a write.
COMPETITION_POLL_MS=3000

# How long a write waits for its receipt before reporting it unconfirmed. An unconfirmed write is
# never retried automatically: it may still land.
COMPETITION_TX_TIMEOUT_MS=120000
COMPETITION_CONFIRMATIONS=1

# --- serving -------------------------------------------------------------------------------------
COMPETITION_PORT=5100

# The read API is public and unauthenticated by design — it only reads the chain. Narrow this to
# your web origin if you would rather not have it read from anywhere.
COMPETITION_CORS_ORIGIN=*
